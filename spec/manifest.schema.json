{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/yabt/manifest.schema.json",
  "title": "YABT package manifest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "sourcePath": { "type": "string" },
    "createdAtUtc": { "type": "string", "format": "date-time" },
    "format": {
      "type": "string",
      "minLength": 1
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "relativePath": { "type": "string" },
          "length": { "type": "integer", "minimum": 0 },
          "lastWriteTimeUtc": { "type": "string", "format": "date-time" },
          "contentHash": {
            "type": ["string", "null"],
            "pattern": "^xxh128:[A-Za-z0-9_-]{21}[AQgw]$"
          }
        },
        "required": ["relativePath", "length", "lastWriteTimeUtc"]
      }
    },
    "totalBytes": { "type": "integer", "minimum": 0 },
    "manifestHash": {
      "type": "string",
      "pattern": "^xxh128:[A-Za-z0-9_-]{21}[AQgw]$"
    },
    "packageName": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "sourcePath",
    "createdAtUtc",
    "format",
    "files",
    "totalBytes",
    "manifestHash",
    "packageName"
  ]
}

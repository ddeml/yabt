{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/yabt/change-manifest.schema.json",
  "title": "YABT live change manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "documentType",
    "schemaVersion",
    "entries",
    "manifestHash"
  ],
  "properties": {
    "documentType": {
      "const": "yabt.changeManifest"
    },
    "schemaVersion": {
      "const": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "manifestHash": {
      "type": "string",
      "pattern": "^xxh128:[A-Za-z0-9_-]{21}[AQgw]$"
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relativePath",
        "changeFingerprint"
      ],
      "properties": {
        "relativePath": {
          "type": "string",
          "minLength": 1
        },
        "artifactLength": {
          "type": "integer",
          "minimum": 0,
          "description": "Actual stored byte length, present only when the projector cannot supply a length for quick target comparison."
        },
        "changeFingerprint": {
          "type": "string",
          "description": "Ordinary files use stat-v1:<UTC timestamp>:<length>; format and provider fingerprints remain type-qualified opaque values.",
          "pattern": "^[a-z0-9_.-]+:[^\\s]+$"
        },
        "contentHash": {
          "type": "string",
          "pattern": "^xxh128:[A-Za-z0-9_-]{21}[AQgw]$"
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/yabt/yabt-policy.schema.json",
  "title": "YABT folder policy",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "type": "string",
      "minLength": 1
    },
    "includePatterns": {
      "type": "array",
      "items": { "type": "string" }
    },
    "excludePatterns": {
      "type": "array",
      "items": { "type": "string" }
    },
    "options": {
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "directoryLinks": {
      "type": ["object", "null"],
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "not": { "enum": [".", ".."] },
        "pattern": "^[^/\\\\\\u0000]+$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "behavior": { "const": "follow" },
          "expectedTarget": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "not": { "pattern": "\\u0000" }
          }
        },
        "required": ["behavior", "expectedTarget"]
      }
    }
  },
  "required": ["format"]
}

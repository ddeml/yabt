{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/yabt/yabt-policy.schema.json",
  "title": "YABT folder policy",
  "type": "object",
  "additionalProperties": true,
  "description": "Unknown top-level settings warn and are ignored. Directory-link approvals remain strict.",
  "properties": {
    "format": {
      "type": "string",
      "minLength": 1
    },
    "includePatterns": {
      "type": ["array", "null"],
      "description": "Currently ignored by mirror and ZIP; nonempty patterns warn that other files may also be archived.",
      "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
    },
    "excludePatterns": {
      "type": ["array", "null"],
      "description": "Currently ignored by mirror and ZIP; nonempty patterns warn that matching files may be archived.",
      "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
    },
    "options": {
      "type": ["object", "null"],
      "description": "Currently ignored by mirror and ZIP with a warning when nonempty. ZIP uses runtime compression settings.",
      "additionalProperties": true
    },
    "directoryLinks": {
      "type": ["object", "null"],
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "not": { "enum": [".", ".."] },
        "pattern": "^[^/\\\\\\u0000]+$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "behavior": { "const": "follow" },
          "expectedTarget": {
            "type": "string",
            "minLength": 1,
            "not": { "pattern": "\\u0000" }
          }
        },
        "required": ["behavior", "expectedTarget"]
      }
    }
  }
}

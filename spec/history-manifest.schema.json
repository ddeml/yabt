{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/yabt/history-manifest.schema.json",
  "title": "YABT history manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "documentType",
    "schemaVersion",
    "entries",
    "manifestHash"
  ],
  "properties": {
    "documentType": {
      "const": "yabt.historyManifest"
    },
    "schemaVersion": {
      "const": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "manifestHash": {
      "$ref": "#/$defs/contentHash"
    }
  },
  "$defs": {
    "canonicalHistoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*//)(?!.*\\\\)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*(?:^|/)\\s)(?!.*\\s(?:/|$))[^/]+(?:/[^/]+)*$",
      "not": {
        "enum": [
          ".yabt-history-manifest.json",
          ".yabt-history-manifest.invalid"
        ]
      }
    },
    "contentHash": {
      "type": "string",
      "pattern": "^xxh128:[A-Za-z0-9_-]{21}[AQgw]$"
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relativePath",
        "storedRelativePath",
        "representation",
        "contentLength",
        "contentHash"
      ],
      "properties": {
        "relativePath": {
          "$ref": "#/$defs/canonicalHistoryPath"
        },
        "storedRelativePath": {
          "$ref": "#/$defs/canonicalHistoryPath"
        },
        "representation": {
          "type": "string",
          "enum": ["materialized", "reference"]
        },
        "contentLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "contentHash": {
          "$ref": "#/$defs/contentHash"
        },
        "lastModifiedUtc": {
          "type": ["string", "null"],
          "format": "date-time",
          "pattern": "(?:Z|\\+00:00)$"
        },
        "contentType": {
          "type": ["string", "null"],
          "pattern": "\\S"
        },
        "metadata": {
          "type": ["object", "null"],
          "minProperties": 1,
          "propertyNames": {
            "pattern": "\\S"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "representation": {
                "const": "reference"
              }
            },
            "required": ["representation"]
          },
          "then": {
            "properties": {
              "storedRelativePath": {
                "pattern": "\\.yabt-ref\\.json$"
              }
            }
          }
        }
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/yabt/yabt-root.schema.json",
  "title": "YABT root descriptor",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "documentType": {
      "type": "string",
      "const": "yabt.backupRoot"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "rootRole": {
      "type": "string",
      "enum": ["source", "target"]
    },
    "archiveId": {
      "type": "string"
    },
    "name": {
      "type": ["string", "null"]
    },
    "defaultStoreId": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "changeManifestCompression": {
      "type": ["string", "null"],
      "enum": ["brotli", "none", null],
      "default": "brotli",
      "description": "Compression used when writing the root live change manifest. Readers inspect both supported representations."
    },
    "historyDeduplicationTinyFileMaximumBytes": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 9223372036854775807,
      "default": 4096,
      "description": "Largest historical object considered too small to deduplicate. A missing or null value uses 4096 bytes."
    },
    "createdAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "livePrefix": {
          "type": "string",
          "default": ""
        },
        "histPrefix": {
          "type": "string",
          "minLength": 1,
          "default": ".yabt-hist"
        }
      },
      "required": ["livePrefix", "histPrefix"]
    },
    "stores": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "credentialRef": {
            "type": ["string", "null"]
          }
        },
        "required": ["id", "kind"]
      }
    }
  },
  "required": [
    "documentType",
    "schemaVersion",
    "archiveId",
    "createdAtUtc",
    "layout",
    "stores"
  ]
}
